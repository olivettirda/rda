      "candidate_genes": ["Saltol/SKC1/OsHKT1;5", "OsHKT1;4"]
    },
    "cold_tolerance": {
      "H2_typical": "0.50-0.80",
      "candidate_genes": ["qLTG3-1", "COLD1", "CTB4a", "bZIP73"]
    },
    "drought_root": {
      "H2_typical": "0.50-0.80",
      "candidate_genes": ["DRO1", "DRO2", "qSOR1"]
    }
  },
  "rice_segregation_distortion_known_regions_DO_NOT_DELETE": [
    {"locus": "S5", "chr": 6, "position_Mb": "5-14", "crosses": "indicaXjaponica"},
