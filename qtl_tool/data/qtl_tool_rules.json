    "QC": "missing<=10%, MAF_polym, chi2_p<0.001_Bonferroni, het<5% RIL",
    "imputation": "Beagle_5.4_Ne=200_window=40cM",
    "linkage_map": "IciMapping_MAP_module_Kosambi",
    "primary_QTL_engine": "ICIM-ADD step=1cM PIN=0.001",
    "threshold": "1000_perms_alpha=0.05_floor=2.5",
    "epistasis": "ICIM-EPI step=5cM PIN=0.0001 LOD=5.0",
    "CI_default": "1-LOD_drop",
    "CI_publication": "ALSO_compute_1.5-LOD_and_95%_Bayes_credible",
    "comparison": "Auto_query_Q-TARO_Gramene_funRiceGenes",
    "report_PVE_with_Beavis_factor_if_N_lt_500": true
