  "beavis_correction_factors": {
    "_note": "Beavis 1998 / Xu 2003 PVE inflation factor by N",
    "N_100": 2.0,
    "N_200": 1.5,
    "N_300": 1.3,
    "N_500": 1.15,
    "N_1000": 1.05,
    "N_gt_1000": 1.0
  }
