    {"locus": "Sb", "chr": 5},
    {"locus": "Sc", "chr": 3},
    {"locus": "S1", "chr": 6, "crosses": "sativaXglaberrima"},
    {"locus": "hsa1", "chr": 12, "crosses": "japonicaXindica"},
    {"locus": "S7", "chr": 7},
    {"locus": "S8", "chr": 6}
  ],
  "warnings_to_display": {
    "if_N_lt_500": "Beavis_effect_PVE_inflation_warning_with_factor",
    "if_H2_lt_0.4": "Recommend_more_envs_or_reps",
    "if_LOD_threshold_lt_2.5": "Use_floor_2.5_to_avoid_liberal_calls",
